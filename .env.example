# Copy to .env.local and adjust. See docs/DATA.md.
# demo (bundled synthetic data) or http (your backend)
VITE_DATA_SOURCE=demo
# base URL of the JSON files in http mode
VITE_DATA_URL=./
# 1 to listen to Server-Sent Events at <VITE_DATA_URL>live/events
VITE_LIVE_FEED=0
# IANA time zone for clocks and schedules; empty = the browser's
VITE_TIME_ZONE=
